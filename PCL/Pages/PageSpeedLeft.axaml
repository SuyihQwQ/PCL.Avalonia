<local:MyPageLeft xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="using:PCL"
                  x:Class="PCL.PageSpeedLeft"
                  HorizontalAlignment="Left" Width="200">
    <local:MyPageLeft.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="0.6*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="0.6*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="0.6*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1*" />
    </local:MyPageLeft.RowDefinitions>
    <TextBlock Text="总进度" Grid.Row="1" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource ColorBrush3}" />
    <Rectangle Grid.Row="2" Height="2" Margin="25,7">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="0" />
                <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.02" />
                <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.98" />
                <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="1" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <TextBlock Text="00.00 %" Grid.Row="3" x:Name="LabProgress" HorizontalAlignment="Center" FontSize="20" />
    <TextBlock Text="下载速度" Grid.Row="5" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource ColorBrush3}" />
    <Rectangle Grid.Row="6" Height="2" Margin="25,7">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="0" />
                <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.02" />
                <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.98" />
                <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="1" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <TextBlock Text="0 B/s" Grid.Row="7" x:Name="LabSpeed" HorizontalAlignment="Center" FontSize="20" />
    <TextBlock Text="剩余文件" Grid.Row="9" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource ColorBrush3}" />
    <Rectangle Grid.Row="10" Height="2" Margin="25,7">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="0" />
                <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.02" />
                <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.98" />
                <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="1" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <TextBlock Text="123456789" Grid.Row="11" x:Name="LabFile" HorizontalAlignment="Center" FontSize="20" />
    <TextBlock Text="剩余线程" Grid.Row="13" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource ColorBrush3}" />
    <Rectangle Grid.Row="14" Height="2" Margin="25,7">
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="0" />
                <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.02" />
                <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.98" />
                <GradientStop Color="{DynamicResource ColorObjectBg1}" Offset="1" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>
    <TextBlock Text="123456789" Grid.Row="15" x:Name="LabThread" HorizontalAlignment="Center" FontSize="20" />
</local:MyPageLeft>
