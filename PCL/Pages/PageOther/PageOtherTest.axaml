<local:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="using:PCL"
                   x:Class="PCL.PageOtherTest"
                   PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Title="实用工具" Margin="0,15">
                <StackPanel Margin="25,38,23,15">
                    <local:MyButton x:Name="BtnDetectChinaUser" Text="检测你是不是中国用户" Height="35" HorizontalAlignment="Left" Padding="13,0,13,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
