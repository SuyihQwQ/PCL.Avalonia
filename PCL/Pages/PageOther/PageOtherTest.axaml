<local:MyPageRight xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="using:PCL"
                   x:Class="PCL.PageOtherTest"
                   PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <TextBlock Text="为便于维护，开源内容中不包含百宝箱功能……"
                   HorizontalAlignment="Center" FontSize="15" Height="30" VerticalAlignment="Center" />
    </local:MyScrollViewer>
</local:MyPageRight>
