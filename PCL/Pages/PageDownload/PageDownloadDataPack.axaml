<local:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCL"
    x:Class="PCL.PageDownloadDataPack"
    PanScroll="Content">
    <local:PageResource x:Name="Content" PageType="DataPack" TypeName="数据包" TypeNameSpaced="数据包">
        <local:PageResource.SearchTags>
            <local:MyComboBoxItem Tag="" Content="{DynamicResource LangDownloadCompSearchSourceAll}" IsSelected="True" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeWorldgen}" Tag="/worldgen" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeTechnology}" Tag="6951/technology" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeGameMechanics}" Tag="/game-mechanics" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeTransportation}" Tag="/transportation" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeStorage}" Tag="/storage" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeMagic}" Tag="6952/magic" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeAdventure}" Tag="6948/adventure" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeFantasy}" Tag="6949/" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeDecoration}" Tag="/decoration" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeMobs}" Tag="/mobs" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeUtility}" Tag="6953/utility" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeEquipment}" Tag="/equipment" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeOptimization}" Tag="/optimization" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeSocial}" Tag="/social" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeLibrary}" Tag="6950/library" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeMod}" Tag="6946/" />
        </local:PageResource.SearchTags>
    </local:PageResource>
</local:MyPageRight>
