<local:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCL"
    x:Class="PCL.PageDownloadResourcePack"
    PanScroll="Content">
    <local:PageResource x:Name="Content" PageType="ResourcePack" TypeName="资源包" TypeNameSpaced="资源包">
        <local:PageResource.SearchTags>
            <local:MyComboBoxItem Tag="" Content="{DynamicResource LangDownloadCompSearchSourceAll}" IsSelected="True" />

            <local:MyComboBoxItem Content="{DynamicResource LangDownloadResourcepackTypeTitleStyle}" IsEnabled="False" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeVanillaLike}" Tag="403/vanilla-like" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeRealistic}" Tag="400/realistic" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeModern}" Tag="401/" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeMedieval}" Tag="402/" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeSteampunk}" Tag="399/" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeThemed}" Tag="/themed" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeSimplistic}" Tag="/simplistic" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadDatapackTypeDecoration}" Tag="/decoration" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadModpackTypeCombat}" Tag="/combat" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadDatapackTypeUtility}" Tag="/utility" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeTweaks}" Tag="/tweaks" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeCursed}" Tag="/cursed" />

            <local:MyComboBoxItem Content="{DynamicResource LangDownloadResourcepackTypeTitleFeature}" IsEnabled="False" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeEntities}" Tag="/entities" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeAudio}" Tag="/audio" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeFonts}" Tag="5244/fonts" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeModels}" Tag="/models" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeLocale}" Tag="/locale" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeGUI}" Tag="/gui" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeCoreShader}" Tag="/core-shaders" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeDynamic}" Tag="404/" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeModed}" Tag="4465/modded" />

            <local:MyComboBoxItem Content="{DynamicResource LangDownloadResourcepackTypeTitleResolution}" IsEnabled="False" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeLowerThan8x}" Tag="/8x-" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="16x" Tag="393/16x" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="32x" Tag="394/32x" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="48x" Tag="/48x" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="64x" Tag="395/64x" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="128x" Tag="396/128x" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="256x" Tag="397/256x" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeHigherThan512x}" Tag="398/512x+" />
        </local:PageResource.SearchTags>
    </local:PageResource>
</local:MyPageRight>
