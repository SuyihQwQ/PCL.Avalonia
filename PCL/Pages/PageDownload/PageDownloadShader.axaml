<local:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCL"
    x:Class="PCL.PageDownloadShader"
    PanScroll="Content">
    <local:PageResource x:Name="Content" PageType="Shader" TypeName="光影包" TypeNameSpaced="光影包">
        <local:PageResource.SearchTags>
            <local:MyComboBoxItem Tag="" Content="{DynamicResource LangDownloadCompSearchSourceAll}" IsSelected="True" />

            <local:MyComboBoxItem Content="{DynamicResource LangDownloadResourcepackTypeTitleStyle}" IsEnabled="False" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeVanillaLike}" Tag="6555/vanilla-like" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypeFantasy}" Tag="6554/fantasy" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadResourcepackTypeRealistic}" Tag="6553/realistic" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypeSemiRealistic}" Tag="/semi-realistic" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypeCartoon}" Tag="/cartoon" />

            <local:MyComboBoxItem Content="{DynamicResource LangDownloadResourcepackTypeTitleFeature}" IsEnabled="False" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypeColoredLighting}" Tag="/colored-lighting" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypePathTracing}" Tag="/path-tracing" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypePBR}" Tag="/pbr" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypeReflections}" Tag="/reflections" />

            <local:MyComboBoxItem Content="{DynamicResource LangDownloadShaderTypeTitleLoad}" IsEnabled="False" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypePotato}" Tag="/potato" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypeLow}" Tag="/low" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypeMedium}" Tag="/medium" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypeHigh}" Tag="/high" />

            <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0048}" IsEnabled="False" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadShaderTypeVanilla}" Tag="/vanilla" ToolTip.Tip="{DynamicResource LangDownloadShaderTypeVanillaToolTip}" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="Iris" Tag="/iris" />
            <local:MyComboBoxItem Margin="15,0,0,0" Content="{DynamicResource LangDownloadPageLeftOptiFine}" Tag="/optifine" />
        </local:PageResource.SearchTags>
    </local:PageResource>
</local:MyPageRight>
