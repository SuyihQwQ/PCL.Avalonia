<local:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCL"
    x:Class="PCL.PageDownloadPack"
    PanScroll="Content">
    <local:PageResource x:Name="Content" PageType="ModPack" TypeName="整合包" TypeNameSpaced="整合包">
        <local:PageResource.SearchTags>
            <local:MyComboBoxItem Tag="" Content="{DynamicResource LangDownloadCompSearchSourceAll}" IsSelected="True" />
            <local:MyComboBoxItem Tag="4484/" Content="{DynamicResource LangDownloadModpackTypeMulti}" />
            <local:MyComboBoxItem Tag="/optimization" Content="{DynamicResource LangDownloadDatapackTypeOptimization}" />
            <local:MyComboBoxItem Tag="4479/challenging" Content="{DynamicResource LangDownloadModpackTypeChallenging}" />
            <local:MyComboBoxItem Tag="4483/combat" Content="{DynamicResource LangDownloadModpackTypeCombat}" />
            <local:MyComboBoxItem Tag="4478/quests" Content="{DynamicResource LangDownloadModpackTypeQuests}" />
            <local:MyComboBoxItem Tag="4472/technology" Content="{DynamicResource LangDownloadDatapackTypeTechnology}" />
            <local:MyComboBoxItem Tag="4473/magic" Content="{DynamicResource LangDownloadDatapackTypeMagic}" />
            <local:MyComboBoxItem Tag="4475/adventure" Content="{DynamicResource LangDownloadDatapackTypeAdventure}" />
            <local:MyComboBoxItem Tag="/kitchen-sink" Content="{DynamicResource LangDownloadModpackTypeSink}" />
            <local:MyComboBoxItem Tag="4476/" Content="{DynamicResource LangDownloadModpackTypeExplore}" />
            <local:MyComboBoxItem Tag="4477/" Content="{DynamicResource LangDownloadModpackTypeGame}" />
            <local:MyComboBoxItem Tag="4474/" Content="{DynamicResource LangDownloadModpackTypeScienceFiction}" />
            <local:MyComboBoxItem Tag="4736/" Content="{DynamicResource LangDownloadModpackTypeSkyblock}" />
            <local:MyComboBoxItem Tag="5128/" Content="{DynamicResource LangDownloadModpackTypeImprove}" />
            <local:MyComboBoxItem Tag="4487/" Content="{DynamicResource LangDownloadModpackTypeFTB}" ToolTip.Tip="{DynamicResource LangDownloadModpackTypeFTBToolTip}" />
            <local:MyComboBoxItem Tag="4480/" Content="{DynamicResource LangDownloadModpackTypeMapBased}" />
            <local:MyComboBoxItem Tag="4481/lightweight" Content="{DynamicResource LangDownloadModpackTypeLightWeight}" />
            <local:MyComboBoxItem Tag="4482/" Content="{DynamicResource LangDownloadModpackTypeHeavyWeight}" />
        </local:PageResource.SearchTags>
    </local:PageResource>
</local:MyPageRight>
