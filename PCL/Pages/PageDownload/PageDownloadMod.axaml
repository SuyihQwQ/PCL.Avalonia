<local:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCL"
    x:Class="PCL.PageDownloadMod"
    PanScroll="Content">
    <local:PageResource x:Name="Content" PageType="Mod" TypeName="Mod" TypeNameSpaced=" Mod ">
        <local:PageResource.SearchTags>
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadCompSearchSourceAll}" Tag="" IsSelected="True" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeWorldgen}" Tag="406/worldgen" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeBiome}" Tag="407/" Margin="15,0,0,0" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeDimension}" Tag="410/" Margin="15,0,0,0" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeMineral}" Tag="408/" Margin="15,0,0,0" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeStructure}" Tag="409/" Margin="15,0,0,0" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeTechnology}" Tag="412/technology" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypePipe}" Tag="415/" Margin="15,0,0,0" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeAuto}" Tag="4843/" Margin="15,0,0,0" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeEnergy}" Tag="417/" Margin="15,0,0,0" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeRedstone}" Tag="4558/" Margin="15,0,0,0" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeFood}" Tag="436/food" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeAgriculture}" Tag="416/" Margin="15,0,0,0" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeGameMechanics}" Tag="/game-mechanics" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeTransportation}" Tag="414/transportation" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeStorage}" Tag="420/storage" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeMagic}" Tag="419/magic" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeAdventure}" Tag="422/adventure" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeDecoration}" Tag="424/decoration" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeMobs}" Tag="411/mobs" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeUtility}" Tag="5191/utility" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeEquipment}" Tag="434/equipment" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeCreativeMode}" Tag="9026/" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeOptimization}" Tag="6814/optimization" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadModTypeDisplay}" Tag="423/" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeSocial}" Tag="435/social" />
            <local:MyComboBoxItem Content="{DynamicResource LangDownloadDatapackTypeLibrary}" Tag="421/library" />
        </local:PageResource.SearchTags>
    </local:PageResource>
</local:MyPageRight>
