<local:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCL"
    x:Class="PCL.PageSetupLaunch"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard x:Name="CardArgument" Margin="0,0,0,15" Title="{DynamicResource LangPageSetupLaunchLaunchOptions}">
                <StackPanel Margin="25,40,25,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupLaunchLaunchVersionIsolation}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboArgumentIndieV2" Grid.Row="0" Grid.Column="1"
                                          local:SettingService.Key="LaunchArgumentIndieV2"
                                          ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchVersionIsolationToolTip}">
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchVersionIsolationClose}"
                                                  ToolTip.Tip="{DynamicResource LangAvalonia0085}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchVersionIsolationModOnly}"
                                                  ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchVersionIsolationModOnlyToolTip}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchVersionIsolationBetaOnly}"
                                                  ToolTip.Tip="{DynamicResource LangAvalonia0065}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0147}"
                                                  ToolTip.Tip="{DynamicResource LangAvalonia0066}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchVersionIsolationAll}"
                                                  ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchVersionIsolationAllToolTip}" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupLaunchLaunchWindowTitle}" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextArgumentTitle" Grid.Row="2" Grid.Column="1"
                                         local:SettingService.Key="LaunchArgumentTitle" MaxHeight="28" MaxLength="100" HintText="{DynamicResource LangPageSetupLaunchLaunchWindowSizeDefault}"
                                         ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchWindowTitleToolTip}" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupLaunchLaunchCustomInfo}" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextArgumentInfo" Grid.Row="4" Grid.Column="1"
                                         local:SettingService.Key="LaunchArgumentInfo" MaxHeight="28" Text="PCL"
                                         ToolTip.Tip="{DynamicResource LangAvalonia0112}" />
                        <TextBlock Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupLaunchLaunchVisibility}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboArgumentVisibie" Grid.Row="6" Grid.Column="1"
                                          local:SettingService.Key="LaunchArgumentVisible">
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchVisibilityCloseOnGameStart}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchVisibilityCloseOnGameClose}" local:SettingService.Value="2" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchVisibilityRestartOnGameClose}" local:SettingService.Value="3" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchVisibilityMinimizeOnGameStart}" local:SettingService.Value="4" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchVisibilityKeep}" local:SettingService.Value="5" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupLaunchLaunchGamePriority}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboArgumentPriority" Grid.Row="8" Grid.Column="1"
                                          local:SettingService.Key="LaunchArgumentPriority">
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchGamePriorityHigh}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchGamePriorityMedium}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchGamePriorityLow}" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="10" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupLaunchLaunchWindowSize}" Margin="0,0,25,0" />
                        <Grid x:Name="PanArgumentWindow" Grid.Row="10" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyComboBox x:Name="ComboArgumentWindowType" local:SettingService.Key="LaunchArgumentWindowType">
                                <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchWindowSizeFullscreen}" />
                                <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchWindowSizeDefault}" />
                                <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchWindowSizeSameWithLaunch}" />
                                <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchWindowSizeCustom}" ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchWindowSizeCustomToolTip}" />
                                <local:MyComboBoxItem Content="{DynamicResource LangPageSetupLaunchLaunchWindowSizeMaximum}" />
                            </local:MyComboBox>
                            <local:MyTextBox x:Name="TextArgumentWindowWidth" Grid.Column="1" Width="60" Margin="50,0,0,0"
                                             local:SettingService.Key="LaunchArgumentWindowWidth"
                                             HorizontalContentAlignment="Center" IsVisible="False" Text="854" />
                            <TextBlock x:Name="LabArgumentWindowMiddle" Grid.Column="2" Text=" × " VerticalAlignment="Center"
                                       FontSize="18" IsVisible="False" />
                            <local:MyTextBox x:Name="TextArgumentWindowHeight" Grid.Column="3" Width="60"
                                             local:SettingService.Key="LaunchArgumentWindowHeight"
                                             HorizontalContentAlignment="Center" IsVisible="False" Text="480"
                                             ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchWindowSizeCustomToolTip}" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardRam" Margin="0,0,0,15" Title="{DynamicResource LangPageSetupLaunchLaunchMem}">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <local:MyRadioBox x:Name="RadioRamType0" Grid.Row="0" Text="{DynamicResource LangPageSetupLaunchLaunchMemAutoAdjust}" Width="110" Margin="0,0,20,0"
                                          local:SettingService.Key="LaunchRamType" local:SettingService.Value="0"
                                          ToolTip.Tip="{DynamicResource LangAvalonia0105}" />
                        <local:MyRadioBox x:Name="RadioRamType1" Grid.Row="2" Text="{DynamicResource LangPageSetupLaunchLaunchMemCustom}" Margin="0,0,20,0"
                                          local:SettingService.Key="LaunchRamType" local:SettingService.Value="1" />
                        <local:MySlider x:Name="SliderRamCustom" Grid.Row="2" Grid.Column="1" IsEnabled="False"
                                        local:SettingService.Key="LaunchRamCustom" MaxValue="49" Value="13" />
                        <local:MyCheckBox x:Name="CheckArgumentRam" Grid.Row="4" Grid.ColumnSpan="2" Height="22"
                                          Text="{DynamicResource LangPageSetupLaunchLaunchMemReduceMemBeforeLaunch}"
                                          local:SettingService.Key="LaunchArgumentRam"
                                          ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchMemReduceMemBeforeLaunchToolTip}" />
                    </Grid>
                    <Grid x:Name="PanRamDisplay" Margin="0,11,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4.7*" />
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="0.7*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LabRamUsedTitle" Grid.ColumnSpan="3" Text="{DynamicResource LangPageSetupLaunchLaunchMemUsedMem}" FontSize="11" Opacity="0.7"
                                   Margin="2,0,0,5" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LabRamGameTitle" Grid.ColumnSpan="3" Text="{DynamicResource LangPageSetupLaunchLaunchMemMemForGame}" FontSize="11" Opacity="0.7"
                                   Margin="0,0,2,5" HorizontalAlignment="Right" />
                        <Rectangle x:Name="RectRamUsed" Grid.Row="1" StrokeThickness="0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Color="{DynamicResource ColorObject3}" Offset="0" />
                                    <GradientStop Color="{DynamicResource ColorObject2}" Offset="0.5" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="RectRamGame" Grid.Row="1" Grid.Column="1" StrokeThickness="0"
                                   Fill="{DynamicResource ColorBrush3}" Opacity="0.5" />
                        <Rectangle x:Name="RectRamEmpty" Grid.Row="1" Grid.Column="2" StrokeThickness="0"
                                   Fill="{DynamicResource ColorBrush6}" Opacity="0.7" />
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="2,3,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="LabRamUsed" Text="0.0 GB" FontSize="16" />
                            <TextBlock x:Name="LabRamTotal" Text=" / 0.0 GB" FontSize="16" />
                        </StackPanel>
                        <TextBlock x:Name="LabRamGame" Grid.Row="2" Grid.ColumnSpan="3" Text="0.0 GB" FontSize="16"
                                   Margin="0,3,2,0" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardSkin" Margin="0,0,0,15" Title="{DynamicResource LangPageSetupLaunchSkin}" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <local:MyHint Margin="0,0,0,10" Text="{DynamicResource LangPageSetupLaunchSkinTips}" HintTheme="Yellow" />
                    <Grid Margin="-1,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <local:MyRadioBox x:Name="RadioSkinType0" Grid.Column="0" Height="22"
                                          local:SettingService.Key="LaunchSkinType" local:SettingService.Value="0"
                                          Text="{DynamicResource LangPageSetupLaunchSkinTypeRandom}" ToolTip.Tip="{DynamicResource LangPageSetupLaunchSkinTypeRandomToolTip}" />
                        <local:MyRadioBox x:Name="RadioSkinType1" Grid.Column="1" Height="22"
                                          local:SettingService.Key="LaunchSkinType" local:SettingService.Value="1"
                                          Text="Steve" />
                        <local:MyRadioBox x:Name="RadioSkinType2" Grid.Column="2" Height="22"
                                          local:SettingService.Key="LaunchSkinType" local:SettingService.Value="2"
                                          Text="Alex" />
                        <local:MyRadioBox x:Name="RadioSkinType3" Grid.Column="3" Height="22"
                                          local:SettingService.Key="LaunchSkinType" local:SettingService.Value="3"
                                          Text="{DynamicResource LangPageSetupLaunchSkinTypeMicrosoft}" ToolTip.Tip="{DynamicResource LangPageSetupLaunchSkinTypeMicrosoftToolTip}" />
                        <local:MyRadioBox x:Name="RadioSkinType4" Grid.Column="4" Height="22"
                                          local:SettingService.Key="LaunchSkinType" local:SettingService.Value="4"
                                          Text="{DynamicResource LangPageSetupLaunchLaunchMemCustom}" ToolTip.Tip="{DynamicResource LangPageSetupLaunchSkinTypeCustomToolTip}" />
                    </Grid>
                    <Grid x:Name="PanSkinID" Margin="0,14,0,2" IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupLaunchSkinTypeMicrosoftName}" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextSkinID" Grid.Column="1" MaxLength="50"
                                         local:SettingService.Key="LaunchSkinID" />
                        <Grid Height="35" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnSkinSave" Text="{DynamicResource LangPageLoginMsSkinSkinSave}" MinWidth="140" Padding="13,0" Margin="0,0,20,0" />
                            <local:MyButton x:Name="BtnSkinCache" Text="{DynamicResource LangDownloadPageLeftRefresh}" MinWidth="140" Padding="13,0" Margin="0,0,20,0"
                                            Grid.Column="1" ToolTip.Tip="{DynamicResource LangPageSetupLaunchSkinRefreshToolTip}" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="PanSkinChange" Margin="0,14,0,2" Height="35" IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnSkinChange" Text="{DynamicResource LangPageSetupLaunchSkinChange}" MinWidth="140" Padding="13,0" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnSkinDelete" Text="{DynamicResource LangPageSetupLaunchSkinReset}" MinWidth="140" Padding="13,0" Margin="0,0,20,0"
                                        ColorType="Red" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptions}" IsSwapped="True" CanSwap="True">
                <Grid Margin="25,40,25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,25,0">
                        <TextBlock Text="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsJVMHead}" VerticalAlignment="Center" />
                        <local:MyIconButton x:Name="BtnAdvanceJvmReset" Height="23" Margin="0,1,0,0" VerticalAlignment="Center"
                                            IsVisible="False" LogoScale="0.9"
                                            ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsJVMHeadReset}"
                                            Logo="M530 0c287 0 521 229 521 511s-233 511-521 511c-233 0-436-151-500-368a63 63 0 0 1 44-79 65 65 0 0 1 80 43c48 162 200 276 375 276 215 0 390-171 390-383s-174-383-390-383c-103 0-199 39-270 106l21-5a63 63 0 0 1 33 123l-157 42a65 65 0 0 1-90-42l-49-183a65 65 0 1 1 126-33l6 26A524 524 0 0 1 530 0z" />
                    </StackPanel>
                    <local:MyTextBox x:Name="TextAdvanceJvm" Grid.Row="0" Grid.Column="1" Height="100"
                                     local:SettingService.Key="LaunchAdvanceJvm" MaxLength="4000"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsJVMHeadTops}" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsJVMTail}" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextAdvanceGame" Grid.Row="2" Grid.Column="1" MaxHeight="28"
                                     local:SettingService.Key="LaunchAdvanceGame"
                                     ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsJVMTailTip}" />
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsCommandBeforeStart}" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextAdvanceRun" Grid.Row="4" Grid.Column="1" MaxHeight="28"
                                     local:SettingService.Key="LaunchAdvanceRun"
                                     ToolTip.Tip="{DynamicResource LangAvalonia0059}" />
                    <local:MyCheckBox x:Name="CheckAdvanceRunWait" Grid.Row="5" Grid.Column="1" IsVisible="False"
                                      Text="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsCommandStartWaitForCommand}" Margin="0,8,0,7"
                                      local:SettingService.Key="LaunchAdvanceRunWait" />
                    <StackPanel Grid.Row="7" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,25,0">
                        <TextBlock Text="{DynamicResource LangPageSetupLaunchLaunchJava}" VerticalAlignment="Center"
                                   ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchJavaToolTip}" />
                        <local:MyIconButton Height="23" Margin="0,1,0,0" VerticalAlignment="Center" Theme="Black" CanClick="False"
                                            Opacity="0.3" LogoScale="0.9"
                                            Logo="M512 1008C238.7 1008 16 785.2 16 512S238.7 16 512 16 1008 238.7 1008 512 785.2 1008 512 1008z m0-896c-220.8 0-400 179.2-400 400s179.2 400 400 400 400-179.2 400-400S732.8 112 512 112z M514.5 638.7c-26.2 0-48-21.7-48-48 0-52.4 32-100.4 81.9-120.9 26.8-11.5 51.2-39.6 44.8-76.8-5.1-27.5-32-51.8-62.7-56.9-26.2-4.4-51.8 2.5-70.4 18.5-16 13.4-24.3 32-24.3 51.2 0 26.2-21.7 48-48 48s-48-21.7-48-48c0-47.3 21.1-92.8 58.2-124.1a182.4 182.4 0 0 1 147.8-39.6c71.0 11.5 129.2 66.5 142.0 133.7 14.0 76.8-27.5 151.6-101.7 183.0-14.0 5.7-23.0 18.5-23.0 32.6 0 26.2-21.7 48-48 48zM514.5 793.6c-15.3 0-30.0-6.4-40.9-16.6-10.8-10.8-16.6-25.6-16.6-40.9s5.7-30.0 16.6-40.9c2.5-2.5 5.7-5.1 8.9-7.0s6.4-3.8 9.6-5.1a57.7 57.7 0 0 1 80 53.1 57.6 57.6 0 0 1-57.6 57.6z" />
                    </StackPanel>
                    <Grid x:Name="PanAdvanceJava" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyComboBox x:Name="ComboAdvanceJava" Grid.Column="0" />
                        <TextBlock x:Name="LabAdvanceJava" Grid.Column="0" Margin="8.5,0,21.5,0" IsHitTestVisible="False"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <local:MyIconButton x:Name="BtnAdvanceJavaSearch" Grid.Column="1" Width="24" Height="24" Margin="5,2,0,2"
                                            LogoScale="0.95" ToolTip.Tip="{DynamicResource LangAvalonia0144}"
                                            Logo="M512.0 838.3c-80.2 0-153.4-29.3-210.2-77.4l75.5-75.5c11.5-11.5 25.8-22.0 25.8-37.0a27.2 27.2 0 0 0-27.1-27.1H104.0c-27.1 0-27.1 23.9-27.1 27.1v271.9a27.1 27.1 0 0 0 27.1 27.1c15.0 0 27.8-16.6 42.5-31.2l77.9-77.9c76.6 67.7 177.1 108.9 287.4 108.9 221.7 0 404.5-166.0 431.2-380.6h-109.8c-25.9 154.2-159.7 271.9-321.3 271.9zM919.9 76.6c-15.0 0-27.8 16.6-42.5 31.3L799.5 185.8c-76.5-67.7-177.1-108.9-287.4-108.9-221.8 0-404.5 166.1-431.3 380.6H190.6c25.9-154.2 159.7-271.9 321.4-271.9 80.2 0 153.4 29.3 210.1 77.4l-75.5 75.5c-11.6 11.5-25.8 22.0-25.8 37.1a27.2 27.2 0 0 0 27.1 27.1h271.9c27.1 0 27.1-23.9 27.1-27.1V103.8a27.1 27.1 0 0 0-27.1-27.1z" />
                    </Grid>
                    <TextBlock Grid.Row="9" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangAvalonia0042}" Margin="0,0,25,0" />
                    <local:MyComboBox x:Name="ComboAdvanceGC" Grid.Row="9" Grid.Column="1" local:SettingService.Key="LaunchAdvanceGC">
                        <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0068}" ToolTip.Tip="{DynamicResource LangAvalonia0058}" />
                        <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0069}" ToolTip.Tip="{DynamicResource LangAvalonia0057}" />
                        <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0104}" ToolTip.Tip="{DynamicResource LangAvalonia0081}" />
                        <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0135}" local:SettingService.Value="4" ToolTip.Tip="{DynamicResource LangAvalonia0082}" />
                        <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0022}" local:SettingService.Value="3" ToolTip.Tip="{DynamicResource LangAvalonia0023}" />
                    </local:MyComboBox>
                    <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="0,12,0,4" HorizontalAlignment="Left">
                        <local:MyCheckBox x:Name="CheckAdvanceDisableJLW" Height="28" Text="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsDisableJLW}"
                                          local:SettingService.Key="LaunchAdvanceDisableJLW"
                                          ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsDisableJLWToolTip}" />
                        <local:MyCheckBox x:Name="CheckAdvanceDisableLUA" Height="28" Text="{DynamicResource LangAvalonia0121}"
                                          local:SettingService.Key="LaunchAdvanceDisableLUA"
                                          ToolTip.Tip="{DynamicResource LangAvalonia0100}" />
                        <local:MyCheckBox x:Name="CheckAdvanceGraphicCard" Height="28" Text="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsGPUPerfence}"
                                          local:SettingService.Key="LaunchAdvanceGraphicCard"
                                          ToolTip.Tip="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsGPUPerfenceToolTip}" />
                        <local:MyCheckBox x:Name="CheckDownloadCert" Height="28" Text="{DynamicResource LangPageSetupSystemDownloadSSL}"
                                          local:SettingService.Key="ToolDownloadCert"
                                          ToolTip.Tip="{DynamicResource LangPageSetupSystemDownloadSSLToolTip}" />
                    </StackPanel>
                    <local:MyHint x:Name="HintMoreAdvancedSetup" Grid.Row="11" Grid.ColumnSpan="2" Margin="0,5,0,10"
                                  Text="{DynamicResource LangPageSetupLaunchLaunchAdvanceOptionsMoreTips}" HintTheme="Blue"
                                  CanClose="True" RelativeSetup="HintMoreAdvancedSetup" />
                </Grid>
            </local:MyCard>
            <local:MyExtraTextButton HorizontalAlignment="Center" Margin="0,-5,0,15"
                x:Name="BtnSwitch" Text="{DynamicResource LangPageSetupLaunchGotoVersionSetting}" IsVisible="False"
                LogoScale="0.9" Logo="M73 584L920 584 608 896C579 925 579 972 608 1001 637 1030 683 1030 712 1001L1149 565C1164 550 1170 531 1170 511 1170 492 1164 472 1149 457L712 21C683-7 637-7 608 21 579 50 579 97 608 126L920 438 73 438C33 438 0 471 0 511 0 551 33 584 73 584Z" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
