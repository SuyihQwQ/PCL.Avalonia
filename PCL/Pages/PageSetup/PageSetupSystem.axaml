<local:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCL"
    x:Class="PCL.PageSetupSystem"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="{DynamicResource LangModMinecraftDialogNewVersionBtnDownload}">
                <StackPanel Margin="25,37,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadVersionDownloadSource}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadSource" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadSource" Grid.Column="1">
                            <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0070}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0032}" IsSelected="True" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupSystemDownloadModListSourceC}" />
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadVersionListSource}" Margin="0,0,25,0" Grid.Row="2" />
                        <local:MyComboBox x:Name="ComboDownloadVersion" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadVersion" Grid.Column="1" Grid.Row="2">
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupSystemDownloadModListSourceA}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0032}" IsSelected="True" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupSystemDownloadModListSourceC}" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadThread}" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadThread" Grid.Row="4" local:SettingService.Key="ToolDownloadThread" MaxValue="255" Value="63" Grid.Column="1"
                                        ToolTip.Tip="{DynamicResource LangPageSetupSystemDownloadThreadToolTip}" />
                        <TextBlock VerticalAlignment="Center" Grid.Row="5" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadSpeedLimit}" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadSpeed" Grid.Row="5" local:SettingService.Key="ToolDownloadSpeed" MaxValue="42" Value="42" Grid.Column="1"
                                        ToolTip.Tip="{DynamicResource LangPageSetupSystemDownloadSpeedLimitToolTip}" />
                        <TextBlock VerticalAlignment="Top" Grid.Row="6" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadTargetFolder}" Margin="0,5,25,5" />
                        <TextBlock Margin="0,5" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadTargetFolderToolTip}" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource LangDownloadPageLeftResource}">
                <StackPanel Margin="25,37,25,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangDownloadCompSearchSource}" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadMod" Grid.Row="0" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadMod" Grid.Column="1">
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupSystemDownloadModListSourceA}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupSystemDownloadModListSourceB}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupSystemDownloadModListSourceC}" IsSelected="True" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadModFileName}" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="2" x:Name="ComboDownloadTranslateV2" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadTranslateV2" Grid.Column="1"
                                          ToolTip.Tip="{DynamicResource LangPageSetupSystemDownloadModFileNameToolTip}">
                            <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0019}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0017}" IsSelected="True" />
                            <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0103}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangAvalonia0018}" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupSystemDownloadModFileNameD}" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadModManageStyle}" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="4" x:Name="ComboModLocalNameStyle" Grid.ColumnSpan="2" local:SettingService.Key="ToolModLocalNameStyle" Grid.Column="1"
                                          ToolTip.Tip="{DynamicResource LangPageSetupSystemDownloadModManageStyleToolTip}">
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupSystemDownloadModManageStyleA}" IsSelected="True" />
                            <local:MyComboBoxItem Content="{DynamicResource LangPageSetupSystemDownloadModManageStyleB}" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource LangPageSetupSystemDownloadAccessibility}">
                <Grid Margin="25,40,25,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadAccessibilityRemindGameUpdate}" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="{DynamicResource LangPageSetupSystemDownloadAccessibilityRemindGameUpdateRelease}" Grid.Column="1" x:Name="CheckUpdateRelease" local:SettingService.Key="ToolUpdateRelease" ToolTip.Tip="{DynamicResource LangPageSetupSystemDownloadAccessibilityRemindGameUpdateReleaseToolTip}" />
                    <local:MyCheckBox Text="{DynamicResource LangPageSetupSystemDownloadAccessibilityRemindGameUpdateBeta}" Grid.Column="2" Height="22" x:Name="CheckUpdateSnapshot" local:SettingService.Key="ToolUpdateSnapshot" ToolTip.Tip="{DynamicResource LangPageSetupSystemDownloadAccessibilityRemindGameUpdateBetaToolTip}" />
                    <TextBlock VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDownloadAccessibilitySetGameLanguage}" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="{DynamicResource LangAvalonia0125}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" x:Name="CheckHelpChinese" local:SettingService.Key="ToolHelpChinese" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource LangPageSetupSystemSystem}">
                <Grid Margin="25,40,25,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemSystemCacheFolder}" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextSystemCache" Grid.Row="0" Grid.Column="1" local:SettingService.Key="SystemSystemCache" ToolTip.Tip="{DynamicResource LangPageSetupSystemSystemCacheFolderToolTip}" HintText="{DynamicResource LangPageSetupLaunchLaunchWindowSizeDefault}">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateNullable />
                            <local:ValidateFolderPath UseMinecraftCharCheck="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <Grid Height="35" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton Grid.Column="0" x:Name="BtnSystemSettingExp" MinWidth="140" Text="{DynamicResource LangPageSetupSystemExportSettings}" Padding="13,0" Margin="0,0,20,0" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSystemSettingImp" MinWidth="140" Text="{DynamicResource LangPageSetupSystemImportSettings}" Padding="13,0" Margin="0,0,20,0" />
                    </Grid>
                </Grid>
            </local:MyCard>
            <local:MyCard x:Name="CardDebug" Margin="0,0,0,15" Title="{DynamicResource LangPageSetupSystemDebug}" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanDebugAnim" Height="22" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangPageSetupSystemDebugAnimSpeed}" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDebugAnim" local:SettingService.Key="SystemDebugAnim" MaxValue="30" Grid.Column="1" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <local:MyCheckBox Grid.Column="0" Text="{DynamicResource LangPageSetupSystemDebugNotCopyExistFileWhenDownload}" Height="22" x:Name="CheckDebugSkipCopy" local:SettingService.Key="SystemDebugSkipCopy" ToolTip.Tip="{DynamicResource LangPageSetupSystemDebugNotCopyExistFileWhenDownloadToolTip}" />
                        <local:MyCheckBox Grid.Column="1" Text="{DynamicResource LangPageSetupSystemDebugDebugMode}" Height="22" x:Name="CheckDebugMode" local:SettingService.Key="SystemDebugMode" ToolTip.Tip="{DynamicResource LangPageSetupSystemDebugDebugModeToolTip}" />
                        <local:MyCheckBox Grid.Column="2" Text="{DynamicResource LangPageSetupSystemDebugDelay}" Height="22" x:Name="CheckDebugDelay" local:SettingService.Key="SystemDebugDelay" ToolTip.Tip="{DynamicResource LangPageSetupSystemDebugDelayToolTip}" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
