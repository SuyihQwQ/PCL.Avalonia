<local:MyPageRight
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PCL"
    x:Class="PCL.PageSetupUI"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15,0,0" Title="{DynamicResource LangAvalonia0133}">
                <StackPanel Margin="25,38,25,15">
                    <TextBlock Text="{DynamicResource LangAvalonia0120}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <local:MyRadioBox local:SettingService.Key="UiLanguage" local:SettingService.Value="zh-CN"
                                          Text="{DynamicResource LangAvalonia0123}" Margin="0,0,20,0" />
                        <local:MyRadioBox local:SettingService.Key="UiLanguage" local:SettingService.Value="en-US"
                                          Text="English" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,15" Title="{DynamicResource LangSetTheme}" x:Name="CardLauncher">
                <Grid Margin="25,40,25,17">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetThemeOpacity}" Margin="0,0,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherTransparent"
                                            MaxValue="600" ValueByKey="10" x:Name="SliderLauncherTransparent" Grid.Column="1" />
                        </Grid>
                        <Grid x:Name="PanLauncherTheme" Height="60" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetThemeTitle}" Margin="0,0,20,0" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="0"
                                              Grid.Column="1" Grid.Row="0" Text="{DynamicResource LangSetThemeNameBlue}" x:Name="RadioLauncherTheme0" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="1"
                                              Grid.Column="2" Grid.Row="0" Text="{DynamicResource LangSetThemeNameCyan}" x:Name="RadioLauncherTheme1" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="2"
                                              Grid.Column="3" Grid.Row="0" Text="{DynamicResource LangSetThemeNameGreen}" x:Name="RadioLauncherTheme2" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="3"
                                              Grid.Column="4" Grid.Row="0" Text="{DynamicResource LangSetThemeNameYellow}" x:Name="RadioLauncherTheme3" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="4"
                                              Grid.Column="5" Grid.Row="0" Text="{DynamicResource LangSetThemeNameBrown}" x:Name="RadioLauncherTheme4" />
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangAvalonia0061}" Margin="0,0,20,0" Grid.Row="1" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherThemeMode" local:SettingService.Value="0"
                                              Grid.Column="1" Grid.Row="1" Text="{DynamicResource LangAvalonia0137}" x:Name="RadioThemeModeFollow" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherThemeMode" local:SettingService.Value="1"
                                              Grid.Column="2" Grid.Row="1" Text="{DynamicResource LangAvalonia0114}" x:Name="RadioThemeModeLight" />
                            <local:MyRadioBox local:SettingService.Key="UiLauncherThemeMode" local:SettingService.Value="2"
                                              Grid.Column="3" Grid.Row="1" Text="{DynamicResource LangAvalonia0115}" x:Name="RadioThemeModeDark" />
                        </Grid>
                        <local:MyCheckBox local:SettingService.Key="UiLauncherLogo" Text="{DynamicResource LangSetThemeShowLogoOnStart}" Margin="-1,0,0,1" Height="22" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <local:MyCard x:Name="CardBackground" Margin="0,0,0,15" Title="{DynamicResource LangBackgroundPic}">
                <StackPanel Margin="25,40,25,20">
                    <Grid x:Name="PanBackgroundSuit" Height="28" Margin="0,0,0,10" IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetBackgroundPicAdaptive}" Margin="0,0,25,0" />
                        <local:MyComboBox local:SettingService.Key="UiBackgroundSuit" x:Name="ComboBackgroundSuit" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="{DynamicResource LangPageVersionOverallCategoryAuto}" ToolTip.Tip="{DynamicResource LangAvalonia0079}" />
                            <local:MyComboBoxItem local:SettingService.Value="4" Content="{DynamicResource LangSetBackgroundPicAdaptiveTile}" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="{DynamicResource LangSetBackgroundPicAdaptiveCentered}" />
                            <local:MyComboBoxItem local:SettingService.Value="3" Content="{DynamicResource LangSetBackgroundPicAdaptiveStretch}" ToolTip.Tip="{DynamicResource LangSetBackgroundPicAdaptiveStretchToolTip}" />
                            <local:MyComboBoxItem local:SettingService.Value="5" Content="{DynamicResource LangAvalonia0072}" />
                            <local:MyComboBoxItem local:SettingService.Value="9" Content="{DynamicResource LangAvalonia0074}" />
                            <local:MyComboBoxItem local:SettingService.Value="7" Content="{DynamicResource LangAvalonia0073}" />
                            <local:MyComboBoxItem local:SettingService.Value="11" Content="{DynamicResource LangAvalonia0024}" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="{DynamicResource LangAvalonia0071}" />
                            <local:MyComboBoxItem local:SettingService.Value="12" Content="{DynamicResource LangAvalonia0025}" />
                            <local:MyComboBoxItem local:SettingService.Value="6" Content="{DynamicResource LangAvalonia0053}" />
                            <local:MyComboBoxItem local:SettingService.Value="10" Content="{DynamicResource LangAvalonia0055}" />
                            <local:MyComboBoxItem local:SettingService.Value="8" Content="{DynamicResource LangAvalonia0054}" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid x:Name="PanBackgroundOpacity" Height="22" Margin="0,0,0,7" IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetThemeOpacity}" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundOpacity" x:Name="SliderBackgroundOpacity" MaxValue="1000" ValueByKey="10" Grid.Column="1" />
                    </Grid>
                    <Grid x:Name="PanBackgroundBlur" Height="22" Margin="0,0,0,10" IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetBackgroundPicBlur}" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundBlur" x:Name="SliderBackgroundBlur" MaxValue="40" Grid.Column="1"
                                        ToolTip.Tip="{DynamicResource LangAvalonia0148}" />
                    </Grid>
                    <local:MyCheckBox local:SettingService.Key="UiBackgroundColorful" Text="{DynamicResource LangSetBackgroundPicColorfulBack}" Margin="-1,0,0,8" Height="22" />
                    <Grid Height="35" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnBackgroundOpen" MinWidth="140" Text="{DynamicResource LangModBaseDialogUploadLogBtnOpenFolder}" Padding="13,0" Margin="0,0,20,0" ToolTip.Tip="{DynamicResource LangSetBackgroundPicOpenFolderToolTip}" />
                        <local:MyButton x:Name="BtnBackgroundRefresh" MinWidth="140" Text="{DynamicResource LangSetBackgroundPicRefresh}" Padding="13,0" Margin="0,0,20,0" ToolTip.Tip="{DynamicResource LangSetBackgroundPicRefreshToolTip}" Grid.Column="1" />
                        <local:MyButton x:Name="BtnBackgroundClear" MinWidth="140" Text="{DynamicResource LangSetBackgroundPicEmpty}" IsVisible="False" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="2" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardMusic" Margin="0,0,0,15" Title="{DynamicResource LangBackgroundMusic}">
                <StackPanel Margin="25,42,25,20">
                    <Grid x:Name="PanMusicVolume" IsVisible="False" Height="22" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetBackgroundMusicVolume}" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderMusicVolume" local:SettingService.Key="UiMusicVolume" MaxValue="1000" ValueByKey="10" Grid.Column="1" />
                    </Grid>
                    <StackPanel x:Name="PanMusicDetail" IsVisible="False" Margin="-1,0,0,3">
                        <local:MyCheckBox Text="{DynamicResource LangSetBackgroundMusicPlayRandom}" Margin="0,0,0,5" Height="22" x:Name="CheckMusicRandom" local:SettingService.Key="UiMusicRandom" />
                        <local:MyCheckBox Text="{DynamicResource LangSetBackgroundMusicPlayOnStart}" Margin="0,0,0,5" Height="22" x:Name="CheckMusicAuto" local:SettingService.Key="UiMusicAuto" />
                        <local:MyCheckBox Text="{DynamicResource LangSetBackgroundMusicPlayDuringGaming}" Margin="0,0,0,5" Height="22" x:Name="CheckMusicStart" local:SettingService.Key="UiMusicStart" />
                        <local:MyCheckBox Text="{DynamicResource LangSetBackgroundMusicPlayDuringLaunching}" Margin="0,0,0,5" Height="22" x:Name="CheckMusicStop" local:SettingService.Key="UiMusicStop" />
                    </StackPanel>
                    <Grid Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnMusicOpen" Text="{DynamicResource LangModBaseDialogUploadLogBtnOpenFolder}" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip.Tip="{DynamicResource LangSetBackgroundMusicOpenFolderToolTip}" />
                        <local:MyButton x:Name="BtnMusicRefresh" Text="{DynamicResource LangSetBackgroundMusicRefresh}" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip.Tip="{DynamicResource LangSetBackgroundMusicRefreshToolTip}" Grid.Column="1" />
                        <local:MyButton x:Name="BtnMusicClear" Text="{DynamicResource LangSetBackgroundMusicEmpty}" MinWidth="140" IsVisible="False" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="2" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardLogo" Margin="0,0,0,15" Title="{DynamicResource LangSetTitle}">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="-1,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.2*" />
                        </Grid.ColumnDefinitions>
                        <local:MyRadioBox Text="{DynamicResource LangSetNone}" x:Name="RadioLogoType0" Height="22" local:SettingService.Key="UiLogoType" local:SettingService.Value="0" Grid.Column="0" />
                        <local:MyRadioBox Text="{DynamicResource LangPageSetupLaunchLaunchWindowSizeDefault}" x:Name="RadioLogoType1" Height="22" local:SettingService.Key="UiLogoType" local:SettingService.Value="1" Grid.Column="1" />
                        <local:MyRadioBox Text="{DynamicResource LangSetText}" x:Name="RadioLogoType2" Height="22" local:SettingService.Key="UiLogoType" local:SettingService.Value="2" Grid.Column="2" />
                        <local:MyRadioBox Text="{DynamicResource LangSetPicture}" x:Name="RadioLogoType3" Height="22" local:SettingService.Key="UiLogoType" local:SettingService.Value="3" Grid.Column="3" />
                    </Grid>
                    <local:MyCheckBox Text="{DynamicResource LangSetTitleLeft}" Margin="-1,8,0,3" Height="22" x:Name="CheckLogoLeft" local:SettingService.Key="UiLogoLeft" IsVisible="False" />
                    <Grid x:Name="PanLogoText" Margin="0,14,0,5" IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetTitleContent}" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextLogoText" local:SettingService.Key="UiLogoText" Grid.Column="1" MaxLength="100" />
                    </Grid>
                    <Grid x:Name="PanLogoChange" Margin="0,14,0,5" Height="35" IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnLogoChange" Text="{DynamicResource LangSetTitlePicChange}" MinWidth="140" Padding="13,0" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnLogoDelete" Text="{DynamicResource LangSetTitlePicEmpty}" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource LangSetHomePageTitle}" x:Name="CardCustom">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="-1,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.2*" />
                        </Grid.ColumnDefinitions>
                        <local:MyRadioBox Text="{DynamicResource LangSetHomePageEmpty}" x:Name="RadioCustomType0" Height="22" local:SettingService.Key="UiCustomType" local:SettingService.Value="0" Grid.Column="0" />
                        <local:MyRadioBox Text="{DynamicResource LangSetHomePagePreset}" x:Name="RadioCustomType3" Height="22" local:SettingService.Key="UiCustomType" local:SettingService.Value="3" Grid.Column="1" />
                        <local:MyRadioBox Text="{DynamicResource LangSetHomePageLocal}" x:Name="RadioCustomType1" Height="22" local:SettingService.Key="UiCustomType" local:SettingService.Value="1" Grid.Column="2" />
                        <local:MyRadioBox Text="{DynamicResource LangSetHomePageOnline}" x:Name="RadioCustomType2" Height="22" local:SettingService.Key="UiCustomType" local:SettingService.Value="2" Grid.Column="3" />
                    </Grid>
                    <local:MyHint Margin="0,15,0,-4" Text="{DynamicResource LangAvalonia0043}" HintTheme="Blue" x:Name="HintCustom" IsVisible="False" />
                    <local:MyHint Margin="0,15,0,6" Text="{DynamicResource LangAvalonia0134}" HintTheme="Yellow" x:Name="HintCustomWarn"
                                  CanClose="True" RelativeSetup="HintCustomWarn" IsVisible="False" />
                    <WrapPanel x:Name="PanCustomLocal" IsVisible="False" Margin="0,0,0,5">
                        <local:MyButton x:Name="BtnCustomRefresh" Text="{DynamicResource LangSetHomePageRefresh}"
                                        MinWidth="140" Height="35" Padding="13,0" Margin="0,10,20,0" HorizontalAlignment="Left" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnCustomFile" Text="{DynamicResource LangSetHomePageReleaseTeachFile}"
                                        MinWidth="140" Height="35" Padding="13,0" Margin="0,10,20,0" HorizontalAlignment="Left" />
                        <local:MyButton x:Name="BtnCustomTutorial" Text="{DynamicResource LangSetHomePageSeeDoc}"
                                        MinWidth="140" Height="35" Padding="13,0" Margin="0,10,20,0" HorizontalAlignment="Left" />
                        <local:MyButton x:Name="BtnCustomFolder" Text="{DynamicResource LangAvalonia0090}"
                                        MinWidth="140" Height="35" Padding="13,0" Margin="0,10,20,0" HorizontalAlignment="Left" />
                    </WrapPanel>
                    <Grid x:Name="PanCustomNet" IsVisible="False" Margin="0,10,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetHomePageDownload}" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextCustomNet" local:SettingService.Key="UiCustomNet" Grid.Column="1" MaxHeight="28"
                                         ToolTip.Tip="{DynamicResource LangAvalonia0034}">
                            <local:MyTextBox.ValidateRules>
                                <local:ValidateNullable />
                                <local:ValidateHttp />
                            </local:MyTextBox.ValidateRules>
                        </local:MyTextBox>
                    </Grid>
                    <Grid x:Name="PanCustomPreset" IsVisible="False" Margin="0,12,10,5" Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetHomePagePresetPage}" Margin="0,0,25,0" />
                        <local:MyComboBox local:SettingService.Key="UiCustomPreset" Grid.ColumnSpan="2" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="{DynamicResource LangLaunchRightPageTips}" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="{DynamicResource LangSetHomePagePresetPageC}" />
                            <local:MyComboBoxItem local:SettingService.Value="4" Content="{DynamicResource LangSetHomePagePresetPageE}" />
                            <local:MyComboBoxItem local:SettingService.Value="5" Content="{DynamicResource LangSetHomePagePresetPageF}" />
                            <local:MyComboBoxItem local:SettingService.Value="6" Content="{DynamicResource LangSetHomePagePresetPageG}" />
                            <local:MyComboBoxItem local:SettingService.Value="9" Content="{DynamicResource LangSetHomePagePresetPageJ}" />
                            <local:MyComboBoxItem local:SettingService.Value="11" Content="{DynamicResource LangSetHomePagePresetPageL}" />
                            <local:MyComboBoxItem local:SettingService.Value="12" Content="{DynamicResource LangSetHomePagePresetPageM}" />
                            <local:MyComboBoxItem local:SettingService.Value="13" Content="{DynamicResource LangAvalonia0006}" />
                            <local:MyComboBoxItem local:SettingService.Value="14" Content="{DynamicResource LangAvalonia0027}" />
                            <local:MyComboBoxItem local:SettingService.Value="15" Content="{DynamicResource LangAvalonia0007}" />
                            <local:MyComboBoxItem local:SettingService.Value="16" Content="{DynamicResource LangAvalonia0097}" />
                            <local:MyComboBoxItem local:SettingService.Value="17" Content="{DynamicResource LangAvalonia0002}" />
                            <local:MyComboBoxItem local:SettingService.Value="18" Content="{DynamicResource LangAvalonia0003}" />
                            <local:MyComboBoxItem local:SettingService.Value="19" Content="{DynamicResource LangAvalonia0008}" />
                            <local:MyComboBoxItem local:SettingService.Value="20" Content="{DynamicResource LangAvalonia0107}" />
                            <local:MyComboBoxItem local:SettingService.Value="21" Content="{DynamicResource LangAvalonia0111}" />
                            <local:MyComboBoxItem local:SettingService.Value="22" Content="{DynamicResource LangAvalonia0015}" />
                            <local:MyComboBoxItem local:SettingService.Value="23" Content="{DynamicResource LangAvalonia0016}" />
                            <local:MyComboBoxItem local:SettingService.Value="24" Content="{DynamicResource LangAvalonia0098}" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardSwitch" Margin="0,0,0,15" Title="{DynamicResource LangHiddenModeTitleB}">
                <StackPanel Margin="25,38,15,15">
                    <TextBlock Margin="0,1,0,1" Text="{DynamicResource LangSetFuncHiddenToolTip}" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1.0*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetFuncHiddenLaunch}" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2" Text="{DynamicResource LangModMinecraftDialogNewVersionBtnDownload}" x:Name="CheckHiddenPageDownload" local:SettingService.Key="UiHiddenPageDownload" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="1" Grid.Column="3" Text="{DynamicResource LangPageSetupLeftLink}" x:Name="CheckHiddenPageLink" local:SettingService.Key="UiHiddenPageLink" IsEnabled="False" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="1" Grid.Column="4" Text="{DynamicResource LangPageVersionLeftSetting}" x:Name="CheckHiddenPageSetup" local:SettingService.Key="UiHiddenPageSetup" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="1" Grid.Column="5" Text="{DynamicResource LangOtherMore}" x:Name="CheckHiddenPageOther" local:SettingService.Key="UiHiddenPageOther" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetFuncHiddenSettingsSubPage}" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="2" Grid.Column="2" Text="{DynamicResource LangPageSetupLeftGame}" x:Name="CheckHiddenSetupLaunch" local:SettingService.Key="UiHiddenSetupLaunch" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="2" Grid.Column="3" Text="{DynamicResource LangPageSetupLeftLink}" x:Name="CheckHiddenSetupLink" local:SettingService.Key="UiHiddenSetupLink" IsEnabled="False" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="2" Grid.Column="4" Text="{DynamicResource LangPageSetupLeftPersonalize}" x:Name="CheckHiddenSetupUI" local:SettingService.Key="UiHiddenSetupUi" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="2" Grid.Column="5" Text="{DynamicResource LangDownloadModpackTypeOther}" x:Name="CheckHiddenSetupSystem" local:SettingService.Key="UiHiddenSetupSystem" />
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetFuncHiddenMoreSubPage}" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="3" Grid.Column="2" Text="{DynamicResource LangOtherHelp}" x:Name="CheckHiddenOtherHelp" local:SettingService.Key="UiHiddenOtherHelp" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="3" Grid.Column="3" Text="{DynamicResource LangPageOtherLeftAbout}" x:Name="CheckHiddenOtherAbout" local:SettingService.Key="UiHiddenOtherAbout" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="3" Grid.Column="4" Text="{DynamicResource LangOtherTool}" x:Name="CheckHiddenOtherTest" local:SettingService.Key="UiHiddenOtherTest" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="3" Grid.Column="5" Text="{DynamicResource LangModBaseDialogFeedbackBtnConfirm}" x:Name="CheckHiddenOtherFeedback" local:SettingService.Key="UiHiddenOtherFeedback" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource LangSetFuncHiddenSpecial}" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="4" Grid.Column="2" Text="{DynamicResource LangSetFuncHiddenSpecialEmail}" x:Name="CheckLauncherEmail" local:SettingService.Key="UiLauncherEmail" ToolTip.Tip="{DynamicResource LangSetFuncHiddenSpecialEmailToolTip}" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="4" Grid.Column="3" Text="{DynamicResource LangSetFuncHiddenSpecialInstanceSetting}" x:Name="CheckHiddenFunctionSelect" local:SettingService.Key="UiHiddenFunctionSelect" ToolTip.Tip="{DynamicResource LangSetFuncHiddenSpecialInstanceSettingToolTip}" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="4" Grid.Column="4" Text="{DynamicResource LangSetFuncHiddenSpecialModUpdate}" x:Name="CheckHiddenFunctionModUpdate" local:SettingService.Key="UiHiddenFunctionModUpdate" ToolTip.Tip="{DynamicResource LangSetFuncHiddenSpecialModUpdateToolTip}" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="4" Grid.Column="5" Text="{DynamicResource LangHiddenModeTitleB}" x:Name="CheckHiddenFunctionHidden" local:SettingService.Key="UiHiddenFunctionHidden" ToolTip.Tip="{DynamicResource LangSetFuncHiddenSpecialFuncHiddenToolTip}" />
                        <local:MyCheckBox Height="22" VerticalAlignment="Center" Grid.Row="4" Grid.Column="6" Text="{DynamicResource LangAvalonia0116}" x:Name="CheckHiddenFunctionModify" local:SettingService.Key="UiHiddenFunctionInstanceModify" ToolTip.Tip="{DynamicResource LangAvalonia0146}" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
