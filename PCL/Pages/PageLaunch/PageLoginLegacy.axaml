<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PCL"
      x:Class="PCL.PageLoginLegacy"
      Tag="True">
    <StackPanel Margin="0,0,0,5" x:Name="PanMain">
        <local:MyHint x:Name="HintChinese" Theme="Red"
                      Text="{DynamicResource LangPageLoginLegacySpecialCharacters}"
                      Margin="0,0,0,15" IsVisible="False" />
        <local:MySkin HorizontalAlignment="Center" x:Name="Skin" HasCape="False" Margin="0,0,0,15" />
        <local:MyComboBox IsEditable="True" x:Name="ComboName" Height="28" IsTextSearchEnabled="False" HintText="{DynamicResource LangPageLoginLegacyID}" />
    </StackPanel>
</Grid>
