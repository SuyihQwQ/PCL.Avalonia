<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PCL.MyRadioButton"
        x:Name="PanBack"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        Background="{DynamicResource ColorBrushSemiTransparent}"
        CornerRadius="13.5" MinHeight="27" MaxHeight="27">
    <StackPanel Orientation="Horizontal">
        <Path x:Name="ShapeLogo"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              RenderTransformOrigin="50%,50%" Margin="12,0,0,0"
              Stretch="Uniform" Fill="White"
              MaxHeight="16" MaxWidth="16" />
        <TextBlock x:Name="LabText"
                   VerticalAlignment="Center"
                   Foreground="White" Margin="8,0,12,0" />
    </StackPanel>
</Border>
