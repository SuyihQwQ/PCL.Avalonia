<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="PCL.MyRadioBox"
      MinWidth="20" MinHeight="20"
      Focusable="True"
      Background="{DynamicResource ColorBrushSemiTransparent}">
    <TextBlock x:Name="LabText"
               IsHitTestVisible="False"
               FontSize="13"
               Margin="26,0,0,0"
               Foreground="{DynamicResource ColorBrush1}"
               HorizontalAlignment="Left"
               VerticalAlignment="Center" />
    <Grid Width="20" Height="20"
          IsHitTestVisible="False"
          HorizontalAlignment="Left"
          VerticalAlignment="Center">
        <Ellipse x:Name="ShapeBorder"
                 StrokeThickness="1.1"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Width="18" Height="18"
                 Margin="1,0,0,0"
                 UseLayoutRounding="False"
                 Stroke="{DynamicResource ColorBrush1}"
                 Fill="{DynamicResource ColorBrushHalfWhite}" />
        <Ellipse x:Name="ShapeDot"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="{Binding #ShapeBorder.Stroke}"
                 Width="9" Height="9"
                 Opacity="0"
                 UseLayoutRounding="False"
                 RenderTransformOrigin="50%,50%"
                 StrokeThickness="0">
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0" ScaleY="0" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</Grid>
