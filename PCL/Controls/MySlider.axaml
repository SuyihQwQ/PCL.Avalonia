<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PCL.MySlider"
        x:Name="PanBack"
        MinHeight="16"
        Focusable="True"
        BorderBrush="{DynamicResource ColorBrushBg0}"
        Background="{DynamicResource ColorBrushSemiTransparent}">
    <Grid x:Name="PanMain" MinHeight="16" MaxHeight="16" IsHitTestVisible="False">
        <Border x:Name="LineBack"
                Height="2"
                Background="{DynamicResource ColorBrushBg0}"
                Opacity="0.3"
                CornerRadius="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="0"
                Margin="0,0,1,0" />
        <Border x:Name="LineFore"
                Height="2"
                Background="{Binding #PanBack.BorderBrush}"
                CornerRadius="1"
                Width="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="1,0,0,0" />
        <Ellipse x:Name="ShapeDot"
                 HorizontalAlignment="Left"
                 Width="10" Height="10"
                 Stroke="{Binding #PanBack.BorderBrush}"
                 StrokeThickness="1.2"
                 Fill="{DynamicResource ColorBrushBg0}"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="50%,50%">
            <Ellipse.RenderTransform>
                <ScaleTransform />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Popup x:Name="Popup"
               IsHitTestVisible="False"
               Placement="Bottom"
               PlacementTarget="{Binding #ShapeDot}"
               VerticalOffset="8"
               HorizontalOffset="0">
            <Border BorderBrush="{DynamicResource ColorBrush1}"
                    BorderThickness="1.5"
                    CornerRadius="3"
                    MaxWidth="500"
                    Background="{DynamicResource ColorBrush8}"
                    Margin="0,0,4,4"
                    BoxShadow="0 2 4 0 #66000000">
                <TextBlock x:Name="TextHint"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="7,5"
                           FontSize="12" />
            </Border>
        </Popup>
    </Grid>
</Border>
