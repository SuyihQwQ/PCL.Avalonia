<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="PCL.MyExtraTextButton"
      RenderTransformOrigin="50%,50%"
      Height="52" Margin="20" Cursor="Hand">
    <Grid.RenderTransform>
        <ScaleTransform ScaleX="0" ScaleY="0" />
    </Grid.RenderTransform>
    <Border x:Name="PanClick"
            CornerRadius="20.8"
            BorderThickness="0.001"
            Background="{DynamicResource ColorBrushSemiTransparent}" />
    <Grid x:Name="PanScale"
          IsHitTestVisible="False"
          RenderTransformOrigin="50%,50%"
          Margin="0,10,0,0">
        <Grid.RenderTransform>
            <ScaleTransform />
        </Grid.RenderTransform>
        <Border x:Name="PanColor"
                CornerRadius="20.8"
                BorderThickness="0.001"
                Background="{DynamicResource ColorBrush3}"
                BoxShadow="0 0 10 0 #33000000" />
        <StackPanel Orientation="Horizontal" Margin="20,0">
            <Path x:Name="Path"
                  Stretch="Uniform"
                  Margin="2,12,0,12"
                  Fill="{DynamicResource ColorBrush8}"
                  RenderTransformOrigin="50%,50%">
                <Path.RenderTransform>
                    <ScaleTransform />
                </Path.RenderTransform>
            </Path>
            <TextBlock x:Name="LabText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ColorBrush8}"
                       FontSize="16"
                       Margin="12,0,0,0.8" />
        </StackPanel>
    </Grid>
</Grid>
