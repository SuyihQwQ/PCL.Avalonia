<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MeloongCore</RootNamespace>
    <AssemblyName>MeloongCore</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ThrottleDebounce" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ThrottleDebounce" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="System.Collections" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Text" />
    <Using Include="System.Net" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="Newtonsoft.Json" />
    <Using Include="Newtonsoft.Json.Linq" />
    <Using Include="MeloongCore.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE.txt" />
  </ItemGroup>

</Project>
